# Copy to .env.local. Get these values from Supabase > Project Settings > API.
# These public values are intended for a browser client protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, only for a trusted local CLI/migration runner. Never prefix with NEXT_PUBLIC_.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Do not place a Supabase secret/service-role key in frontend code or NEXT_PUBLIC_ variables.
# This site does not require one for the current static homepage.
